{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Servidor PHP + navegador",
      "type": "php",
      "request": "launch",
      "runtimeArgs": ["-S", "localhost:8000", "-t", "."],
      "program": "",
      "cwd": "${workspaceRoot}",
      "port": 9003,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
        "uriFormat": "http://localhost:%s/login.php"
      }
    }
  ]
}